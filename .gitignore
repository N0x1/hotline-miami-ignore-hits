# Only original research tools; extracted game data and downloaded sources stay local.
/research/*
!/research/*.py
!/research/requirements.txt
!/research/README.md

# Keep the initial testable binary/package with its source baseline.
/dist/*
!/dist/HotlineMiami-IgnoreHits.exe
!/dist/HotlineMiami-IgnoreHits.zip
!/dist/HotlineMiami-IgnoreHits-v*.exe
!/dist/HotlineMiami-IgnoreHits-v*.zip

*.log
__pycache__/
*.pyc
.venv/
.vs/
bin/
obj/
*.user
*.suo

# Superseded development downloads remain available in Git history.
/dist/HotlineMiami-IgnoreHits-v0.2.exe
/dist/HotlineMiami-IgnoreHits-v0.2.zip
